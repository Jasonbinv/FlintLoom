# Copy to `.env` and fill FLINTLOOM_API_KEY.
# Host and CLI load `<workspace>/.env`. Process env wins over the file.
# This is the model vendor key, not the local host token in ~/.flintloom/credentials.

# DashScope (Qwen) OpenAI-compatible endpoint
FLINTLOOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FLINTLOOM_API_KEY=sk-xxx
FLINTLOOM_CHAT_MODEL=qwen3.7-plus

# Alternative: DeepSeek
# FLINTLOOM_BASE_URL=https://api.deepseek.com/v1
# FLINTLOOM_CHAT_MODEL=deepseek-chat

# Telegram channel (optional; host overlays when polling)
# FLINTLOOM_TELEGRAM_TOKEN=123456:ABC...
# FLINTLOOM_TELEGRAM_CHAT_IDS=123456789,-1001234567890

# Hybrid: local llama chat + DashScope media (optional)
# FLINTLOOM_BASE_URL=http://127.0.0.1:8080/v1
# FLINTLOOM_API_KEY=local
# FLINTLOOM_CHAT_MODEL=qwen2.5-1.5b
# FLINTLOOM_MEDIA_API_KEY=sk-xxx
# FLINTLOOM_MEDIA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional guard on a separate cloud endpoint while chat is local
# FLINTLOOM_GUARD_API_KEY=sk-xxx
# FLINTLOOM_GUARD_BASE_URL=https://api.deepseek.com/v1
# FLINTLOOM_GUARD_MODEL=deepseek-chat

# Web search (composer 联网). Process env wins over this file.
# FLINTLOOM_SEARCH_PROVIDER=searxng
# FLINTLOOM_SEARXNG_URL=http://127.0.0.1:8080
# FLINTLOOM_TAVILY_API_KEY=
# FLINTLOOM_BRAVE_API_KEY=
# FLINTLOOM_BOCHA_API_KEY=
# Brave: set a spend cap in the API dashboard so the $5 credit does not overcharge.
