# Copy to `.env` and fill FLINTLOOM_API_KEY.
# Host and CLI load `<workspace>/.env`. Process env wins over the file.
# This is the model vendor key, not the local host token in ~/.flintloom/credentials.

# DashScope (Qwen) OpenAI-compatible endpoint
FLINTLOOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FLINTLOOM_API_KEY=sk-xxx
FLINTLOOM_CHAT_MODEL=qwen3.7-plus

# Alternative: DeepSeek
# FLINTLOOM_BASE_URL=https://api.deepseek.com/v1
# FLINTLOOM_CHAT_MODEL=deepseek-chat

# Telegram channel (optional; host overlays when polling)
# FLINTLOOM_TELEGRAM_TOKEN=123456:ABC...
# FLINTLOOM_TELEGRAM_CHAT_IDS=123456789,-1001234567890
