{
  "name": "flintloom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "flint": "tsx apps/cli/src/bin.ts",
    "desktop": "tsx scripts/desktop-dev.ts",
    "desktop:stop": "tsx scripts/kill-services.ts desktop",
    "desktop:restart": "tsx scripts/restart.ts desktop",
    "desktop:app": "tsx scripts/desktop-electron.ts",
    "desktop:app:stop": "tsx scripts/kill-services.ts desktop",
    "desktop:app:restart": "tsx scripts/restart.ts desktop:app",
    "wechat-bridge": "tsx apps/wechat-bridge/src/bin.ts",
    "wechat-bridge:stop": "tsx scripts/kill-services.ts wechat-bridge",
    "wechat-bridge:restart": "tsx scripts/restart.ts wechat-bridge",
    "services:stop": "tsx scripts/kill-services.ts all"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@flintloom/a2ui": "workspace:*",
    "@flintloom/channel": "workspace:*",
    "@flintloom/channel-acp": "workspace:*",
    "@flintloom/channel-webhook": "workspace:*",
    "@flintloom/channel-telegram": "workspace:*",
    "@flintloom/channel-discord": "workspace:*",
    "@flintloom/channel-slack": "workspace:*",
    "@flintloom/channel-feishu": "workspace:*",
    "@flintloom/channel-wecom": "workspace:*",
    "@flintloom/docforge": "workspace:*",
    "@flintloom/fs": "workspace:*",
    "@flintloom/grep": "workspace:*",
    "@flintloom/host": "workspace:*",
    "@flintloom/infographic": "workspace:*",
    "@flintloom/knowledge": "workspace:*",
    "@flintloom/loop": "workspace:*",
    "@flintloom/mcp": "workspace:*",
    "@flintloom/media-tools": "workspace:*",
    "@flintloom/models": "workspace:*",
    "@flintloom/models-chat": "workspace:*",
    "@flintloom/models-guard": "workspace:*",
    "@flintloom/models-media": "workspace:*",
    "@flintloom/session": "workspace:*",
    "@flintloom/shell": "workspace:*",
    "@flintloom/skill": "workspace:*",
    "@flintloom/tools": "workspace:*",
    "@flintloom/web-search": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
